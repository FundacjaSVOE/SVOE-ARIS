# ==========================================
# SVOE-ARIS Environment Configuration
# ==========================================

ARIS_VERSION=1.0

ENVIRONMENT=development        # development | staging | production
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
LOG_PATH=logs/                 # Каталог для хранения логов
DATABASE_PATH=data/aris.db     # Путь к базе данных / памяти ARIS

TIMEZONE=Europe/Warsaw          # Часовой пояс работы редакции


# ==========================================
# AI & LLM Engine
# ==========================================

# Режим AI: cloud | local | hybrid
AI_MODE=cloud

# Провайдер: openrouter | local | ollama | openai | gemini
LLM_PROVIDER=openrouter

# API Ключ (пусто, если используется local/ollama)
LLM_API_KEY=

# Модель (например: qwen2.5, llama3, gpt-4o-mini, mistral-7b)
LLM_MODEL=qwen2.5

DEFAULT_LANGUAGE=ru            # Язык по умолчанию для базовых промптов


# ==========================================
# Agent & System Control
# ==========================================

# Режим работы агентов: full | test | debug | scout_only | writer_only
AGENT_MODE=full

# Контроль качества и ревью
SUPERVISOR_ENABLED=true
HUMAN_REVIEW_ENABLED=true


# ==========================================
# Schedule & Content Slots
# ==========================================

MORNING_POST_TIME=09:00
EVENING_POST_TIME=19:00


# ==========================================
# Telegram & Publishing
# ==========================================

TELEGRAM_ENABLED=true

# Режим публикации: draft (только локальные черновики) | auto (автопубликация)
PUBLISH_MODE=draft

# Telegram API Token
TELEGRAM_BOT_TOKEN=

# Target Telegram Channels
TELEGRAM_CHANNEL_ID_RU=@your_channel_ru
TELEGRAM_CHANNEL_ID_PL=@your_channel_pl
TELEGRAM_CHANNEL_ID_EN=@your_channel_en
TELEGRAM_CHANNEL_ID_DE=@your_channel_de
